  "chat.tools.terminal.autoApprove": {
    "/^python3 - <<'PY'\nfrom pathlib import Path\nfrom datetime import date\n\nroot = Path\\(\"\\.\"\\)\\.resolve\\(\\)\nexclude_dirs = \\{\"\\.git\", \"node_modules\", \"\\.next\", \"dist\", \"build\", \"out\", \"coverage\", \"\\.turbo\", \"\\.vercel\"\\}\nexclude_files = \\{\"context\\.md\", \"\\.DS_Store\"\\}\nexclude_prefixes = \\{\"\\.env\"\\}\n\n\ndef should_exclude\\(path: Path\\) -> bool:\n    rel = path\\.relative_to\\(root\\)\n    for part in rel\\.parts:\n        if part in exclude_dirs:\n            return True\n    if path\\.name in exclude_files:\n        return True\n    if any\\(path\\.name == p or path\\.name\\.startswith\\(p \\+ \"\\.\"\\) for p in exclude_prefixes\\):\n        return True\n    return False\n\n\ndef is_text_file\\(path: Path\\) -> bool:\n    try:\n        data = path\\.read_bytes\\(\\)\n    except Exception:\n        return False\n    if b\"\\\\x00\" in data:\n        return False\n    try:\n        data\\.decode\\(\"utf-8\"\\)\n        return True\n    except UnicodeDecodeError:\n        return False\n\n\nfiles = \\[\\]\nfor p in root\\.rglob\\(\"\\*\"\\):\n    if not p\\.is_file\\(\\):\n        continue\n    if should_exclude\\(p\\):\n        continue\n    if not is_text_file\\(p\\):\n        continue\n    files\\.append\\(p\\)\n\nfiles\\.sort\\(key=lambda p: str\\(p\\.relative_to\\(root\\)\\)\\.lower\\(\\)\\)\n\nout_path = root / \"context\\.md\"\nwith out_path\\.open\\(\"w\", encoding=\"utf-8\"\\) as f:\n    f\\.write\\(\"# Repository context\\\\n\\\\n\"\\)\n    f\\.write\\(f\"Generated by GitHub Copilot on \\{date\\.today\\(\\)\\.isoformat\\(\\)\\}\\.\\\\n\\\\n\"\\)\n    f\\.write\\(\"## Files included\\\\n\"\\)\n    for p in files:\n        f\\.write\\(f\"- \\{p\\.relative_to\\(root\\)\\.as_posix\\(\\)\\}\\\\n\"\\)\n    for p in files:\n        rel = p\\.relative_to\\(root\\)\\.as_posix\\(\\)\n        f\\.write\\(\"\\\\n\\\\n---\\\\n\"\\)\n        f\\.write\\(f\"File: \\{rel\\}\\\\n\"\\)\n        f\\.write\\(\"---\\\\n\\\\n\"\\)\n        content = p\\.read_text\\(encoding=\"utf-8\"\\)\n        f\\.write\\(content\\)\n        if not content\\.endswith\\(\"\\\\n\"\\):\n            f\\.write\\(\"\\\\n\"\\)\n\nprint\\(f\"Wrote \\{out_path\\}\"\\)\nPY$/": {
